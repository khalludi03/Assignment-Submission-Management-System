# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=assignment_system

# ASP.NET Core API
# Connection string for the backend (overrides appsettings.json when set)
# ASPNETCORE_ENVIRONMENT=Development

# JWT (only override in real deployments; dev defaults are in appsettings.json)
# JWT__SIGNINGKEY=replace-with-a-long-random-string

# Frontend -> backend proxy target (used by frontend/next.config.ts)
BACKEND_URL=http://localhost:5270
